rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 1;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId.toString();
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Admins can read all user profiles
      allow read: if isAdmin();
      
      // Users can update their own profile (except role)
      allow update: if isAuthenticated() && 
                      request.auth.uid == userId &&
                      request.resource.data.role == resource.data.role;
      
      // Only allow creation during registration (handled by backend/auth)
      allow create: if isAuthenticated();
    }
    
    // Expenses collection
    match /expenses/{expenseId} {
      // Users can only create expenses with their own user_id
      allow create: if isAuthenticated() && 
                      request.resource.data.user_id.toString() == request.auth.uid &&
                      request.resource.data.keys().hasAll([
                        'user_id', 'username', 'user_email', 'expense_id',
                        'description', 'expense_date', 'created_at', 'synced_at'
                      ]) &&
                      // Validate image size if present (max 1MB base64 string ~750KB original)
                      (!request.resource.data.keys().hasAny(['invoice_image_base64']) ||
                       request.resource.data.invoice_image_base64.size() < 1400000);
      
      // Users can only read their own expenses
      allow read: if isAuthenticated() && 
                    resource.data.user_id.toString() == request.auth.uid;
      
      // Admins can read all expenses
      allow read: if isAdmin();
      
      // No updates or deletes allowed (immutable records for audit trail)
      allow update, delete: if false;
    }
    
    // Sync metadata collection (for tracking sync status)
    match /sync_metadata/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAdmin();
    }
  }
}
